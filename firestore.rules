rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) 
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('role' in data) || data.role == 'user'); // Prevent self-elevating to admin
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'content', 'createdAt'])
        && data.authorId == request.auth.uid
        && data.content is string && data.content.size() <= 5000
        && data.createdAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'createdAt'])
        && (data.senderId == request.auth.uid || data.senderId == 'ai-bot')
        && data.text is string && data.text.size() <= 2000
        && data.createdAt == request.time;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'updatedAt']);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPost(incoming());
      allow update: if isOwner(existing().authorId) 
        && isValidPost(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'media', 'updatedAt']);
      allow delete: if isOwner(existing().authorId);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      }
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || resource.data.senderId == 'ai-bot');
      allow create: if isSignedIn() && isValidMessage(incoming());
    }

    match /communities/{communityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(existing().ownerId);
    }

    match /marketplace/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(existing().sellerId);
    }
  }
}
